# Kopiera den här filen till en ny fil som heter ".env"
# och fyll i värdena från ditt Supabase-projekt:
# Supabase -> Project Settings -> API

# Projektets adress (Project URL)
VITE_SUPABASE_URL=https://DITT-PROJEKT.supabase.co

# Den publika nyckeln (anon public key) – den är OK att visa öppet
VITE_SUPABASE_ANON_KEY=DIN-ANON-NYCKEL-HÄR

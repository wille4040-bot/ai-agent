# --- Frontend (Vite) ---
# Kopiera till .env.local och fyll i från ditt Supabase-projekt.
# Utan dessa körs appen ändå, men bokning/betalning och live-tillgänglighet
# är avstängda (statisk fallback).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Edge Functions (sätts som secrets, INTE i frontend) ---
# supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=... \
#   RESEND_API_KEY=... EMAIL_FROM="Sommen Hütten <buchung@dindomän.se>" \
#   ALLOW_ORIGIN=https://din-domän.se
#
# STRIPE_SECRET_KEY        – Stripe hemlig nyckel (sk_...)
# STRIPE_WEBHOOK_SECRET    – Signeringshemlighet för webhooken (whsec_...)
# RESEND_API_KEY           – Resend API-nyckel för bekräftelse- och anresemejl
# EMAIL_FROM               – Avsändaradress (verifierad domän i Resend)
# ALLOW_ORIGIN             – Tillåten origin för CORS (din webbdomän)
# PRE_ARRIVAL_DAYS         – Antal dagar före ankomst för anresemejl (default 3)
# CRON_SECRET              – Delad hemlighet som skyddar pre-arrival-funktionen
#
# SUPABASE_URL och SUPABASE_SERVICE_ROLE_KEY tillhandahålls automatiskt
# av Supabase i Edge Functions – behöver inte sättas manuellt.
